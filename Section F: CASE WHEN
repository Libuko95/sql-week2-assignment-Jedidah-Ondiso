---Q29. Write a query using CASE WHEN to label each exam result with a grade description: 

select result_id,
       marks,
     case
	     when marks >= 80 then 'Distinction'
     	 when marks >= 60 then 'Merit'
     	 when marks >= 40 then 'Pass'
     	 else 'Fail'
     end
     as performance  
 from greenwood_academy.exam_results
 order by marks;

--Q30. Write a query using CASE WHEN to label each student
select first_name, 
       last_name,
       class,
       case  
       	when class between 'Form 3' and 'Form 4' then 'senior' 
       	else 'junior' 
       end
       as student_level 
from greenwood_academy.students;
